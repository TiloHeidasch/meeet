# Phase 2 map style configuration. No public tile or geocoder fallback is used.
NEXT_PUBLIC_MAP_STYLE_URL=
# Optional provider/style attribution shown in the MapLibre control.
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Server-only meeting providers. Options are fixture, configured, and
# self-hosted-routing. With no mode, configured is selected. Set fixture
# explicitly for deterministic local scheduled-surface behavior.
MEEET_PROVIDER_MODE=configured
MEEET_PROVIDER_DEPLOYMENT=unknown
MEEET_PROVIDER_TIMEOUT_MS=4000
MEEET_PROVIDER_MAX_RESPONSE_BYTES=524288
# Never enable this in production. It is only for trusted local HTTP mocks.
MEEET_ALLOW_HTTP_PROVIDER_ENDPOINTS=false

# Canonical scheduled meeting artifact. This must be an absolute server-only
# manifest path whose binary MVV payload was compiled under Node 24.
MEEET_SCHEDULE_ARTIFACT_PATH=
# Operational policy: one in-process calculation, a fixed 90-second deadline,
# and a conservative 4 GiB minimum runtime declaration for configured mode.
MEEET_SCHEDULED_CONCURRENCY=1
MEEET_SCHEDULED_DEADLINE_MS=90000
MEEET_SCHEDULED_MIN_MEMORY_GIB=4

# These values must never use NEXT_PUBLIC_. Tokens are sent only by Node route
# handlers to the configured provider/gateway.
MEEET_ROUTING_GATEWAY_URL=
MEEET_ROUTING_GATEWAY_TOKEN=
# Required together when MEEET_ROUTING_GATEWAY_URL is set.
MEEET_ROUTING_MVG_SOURCE_URL=
MEEET_ROUTING_MVG_LICENSE=
MEEET_ROUTING_MVG_LICENSE_URL=
MEEET_ROUTING_MVG_ATTRIBUTION=
MEEET_ROUTING_MVG_VERSION=
MEEET_ROUTING_MVG_RETRIEVED_AT=
MEEET_ROUTING_MVV_SOURCE_URL=
MEEET_ROUTING_MVV_LICENSE=
MEEET_ROUTING_MVV_LICENSE_URL=
MEEET_ROUTING_MVV_ATTRIBUTION=
MEEET_ROUTING_MVV_VERSION=
MEEET_ROUTING_MVV_RETRIEVED_AT=

# Route-first self-hosted adapters. This mode requires
# MEEET_PROVIDER_DEPLOYMENT=self-hosted and a generated immutable manifest
# loaded from MEEET_ROUTING_MANIFEST_PATH. Only endpoints, profiles, and
# server-only secrets are configured here. OTP 2.6 uses /otp/gtfs/v1;
# GraphHopper uses /route. These adapters are not yet used by calculation.
MEEET_OTP_GRAPHQL_URL=
MEEET_OTP_TOKEN=
MEEET_OTP_PROFILE=
MEEET_GRAPHHOPPER_URL=
MEEET_GRAPHHOPPER_TOKEN=
MEEET_GRAPHHOPPER_BIKE_PROFILE=
MEEET_GRAPHHOPPER_CAR_PROFILE=
MEEET_ROUTING_MANIFEST_PATH=

# Release-only external gate. The gate must point at the pinned OTP 2.6 image
# with the imported fixture graph; setting REQUIRED without the endpoint fails
# the test instead of allowing a skipped check to count as evidence.
MEEET_ROUTING_INTEGRATION_OTP_URL=
MEEET_ROUTING_INTEGRATION_REQUIRED=false

MEEET_GEOCODING_ENDPOINT=
MEEET_GEOCODING_TOKEN=
MEEET_GEOCODING_SOURCE_NAME=
MEEET_GEOCODING_SOURCE_URL=
MEEET_GEOCODING_LICENSE=
MEEET_GEOCODING_LICENSE_URL=
MEEET_GEOCODING_ATTRIBUTION=
MEEET_GEOCODING_VERSION=
MEEET_GEOCODING_RETRIEVED_AT=
MEEET_POI_ENDPOINT=
MEEET_POI_TOKEN=
MEEET_POI_SOURCE_NAME=
MEEET_POI_SOURCE_URL=
MEEET_POI_LICENSE=
MEEET_POI_LICENSE_URL=
MEEET_POI_ATTRIBUTION=
MEEET_POI_VERSION=
MEEET_POI_RETRIEVED_AT=
