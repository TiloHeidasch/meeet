# Local map style and truthful source attribution.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenFreeMap, © OpenStreetMap contributors

# Deterministic credential-free local scheduled-surface profile.
MEEET_PROVIDER_MODE=fixture
MEEET_PROVIDER_DEPLOYMENT=fixture
MEEET_PROVIDER_TIMEOUT_MS=4000
MEEET_PROVIDER_MAX_RESPONSE_BYTES=524288
# Never enable this in production; it is only for trusted local HTTP mocks.
MEEET_ALLOW_HTTP_PROVIDER_ENDPOINTS=false

# No artifact path is set for local fixture development. Full-feed configured
# runs require an operator-created absolute manifest path and sibling payload,
# both compiled under Node 24; put that path in a separate local env file.
# Configured-mode operational policy defaults: one admission, a fixed 90-second
# deadline, and a conservative 4 GiB minimum runtime declaration.
MEEET_SCHEDULED_CONCURRENCY=1
MEEET_SCHEDULED_DEADLINE_MS=90000
MEEET_SCHEDULED_MIN_MEMORY_GIB=4

# No secret, token, gateway, route-first, OTP, GraphHopper, geocoding, POI, or
# release-gate setting belongs in this local template.
