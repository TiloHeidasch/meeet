# Copy to deploy/production.env. Use docker compose --env-file deploy/production.env.
# Replace every digest placeholder with the release-approved immutable digest.

# Required: immutable GHCR runner reference printed by the publish workflow.
# Keep the registry path lowercase and use the full digest, never a branch/tag
# identity. Replace the placeholders before running the preflight.
MEEET_IMAGE=ghcr.io/<lowercase-owner>/meeet@sha256:<64-lowercase-hex-digest>

# Required when compiling or rotating a schedule artifact on the server. This
# is the separately published compiler target from the same commit.
MEEET_COMPILER_IMAGE=ghcr.io/<lowercase-owner>/meeet-artifact-compiler@sha256:<64-lowercase-hex-digest>

# Required: remotely managed Cloudflare Tunnel image. It must include both a
# release tag and an immutable sha256 digest. No tunnel token belongs in this
# file or in ordinary service environment variables.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:<tag>@sha256:<64-lowercase-hex-digest>

# Required host-side directory containing the immutable MVV manifest and its
# sibling .v8.bin payload. The Compose bind is read-only and never creates it.
MEEET_SCHEDULE_HOST_DIR=/srv/meeet/artifacts

# Required host-side file containing only the Cloudflare Tunnel token.
CLOUDFLARED_TOKEN_FILE=/etc/meeet/secrets/cloudflare-tunnel-token
