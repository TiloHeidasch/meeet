# Copy to deploy/production.env. Use docker compose --env-file deploy/production.env.
# This pins the current published release; replace the runner/compiler pair
# together with the exact values emitted by a subsequent publishing workflow.

# Current immutable runner reference from the successful GitHub Actions publish
# for main commit 00c9e410c45666e43866f05de4927d73c738cec0. Replace this runner
# and compiler pair together with the exact values printed by a later workflow.
MEEET_IMAGE=ghcr.io/tiloheidasch/meeet@sha256:cd1659e1d02e51492017d3e0f8fa96dc6a36ce629cccaa5d6853225376c64d25

# The runtime Compose project runs this compiler as a one-shot startup step that
# fetches the latest MVV feed and compiles (or keeps) the artifact in
# MEEET_SCHEDULE_HOST_DIR before meeet starts. This compiler is from the same
# published commit as the runner above.
MEEET_COMPILER_IMAGE=ghcr.io/tiloheidasch/meeet-artifact-compiler@sha256:a0110f8139acf9d23a612eea4a489ae74fd1fad58e9cfa5e93ec52aad2d2fd51

# Required host-side directory containing the immutable MVV manifest and its
# sibling .v8.bin payload. The Compose bind is read-only and never creates it.
MEEET_SCHEDULE_HOST_DIR=/srv/meeet/artifacts

# Cloudflare Tunnel token for the remotely managed tunnel (cloudflared:latest,
# `tunnel run`). Only this key may carry a token in the deployment environment.
TUNNEL_TOKEN=<Cloudflare tunnel token>
