# Copy this file to versions.env and replace every REPLACE_WITH_* value.
# Keep versions.env local and record its values in the deployment manifest.
GRAPHOPPER_RELEASE=10.2

# The upstream project/release is graphhopper/graphhopper at tag 10.2.
# Supply the verified repository locator and the 40-character commit for that tag.
GRAPHOPPER_SOURCE_REPOSITORY=REPLACE_WITH_VERIFIED_UPSTREAM_REPOSITORY_LOCATOR
GRAPHOPPER_SOURCE_COMMIT=REPLACE_WITH_40_HEX_RELEASE_COMMIT

# Both images must be immutable, digest-qualified Debian/Ubuntu-based images.
GRAPHOPPER_BUILD_IMAGE=REPLACE_WITH_DIGESTED_MAVEN_JDK_IMAGE
GRAPHOPPER_RUNTIME_IMAGE=REPLACE_WITH_DIGESTED_JRE_IMAGE

# The local build output is an intermediate only.  Import, verification, and
# runtime use the published digest-qualified project-owned image below.
GRAPHHOPPER_BUILD_OUTPUT_IMAGE=REPLACE_WITH_LOCAL_BUILD_OUTPUT_REFERENCE
GRAPHHOPPER_IMAGE=REPLACE_WITH_PROJECT_GRAPHHOPPER_IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST
GRAPHHOPPER_IMAGE_DIGEST=REPLACE_WITH_GENERATED_GRAPHHOPPER_IMAGE_DIGEST

# Optional runtime tuning; values are JVM memory quantities such as 512m or 2g.
GRAPHOPPER_JAVA_XMS=512m
GRAPHOPPER_JAVA_XMX=2g

# OTP must be a digest-qualified 2.6 image.  A tag-only value is rejected by
# the deployment process; replace this placeholder with the verified digest.
OTP_IMAGE=REPLACE_WITH_OTP_2_6_IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST

# These values are generated by generate-routing-manifest.py for one immutable
# input/artifact/manifest version.  Do not hand-edit the generated hashes.
ROUTING_INPUT_PATH=./routing/inputs/versions/REPLACE_WITH_INPUT_VERSION
OTP_GRAPH_BUILD_PATH=./routing/otp/data/graphs/versions/europe-berlin-mvv-2.6.0
OTP_GRAPH_ARTIFACT_PATH=./routing/otp/data/graphs/versions/europe-berlin-mvv-2.6.0
GRAPHHOPPER_ARTIFACT_BUILD_PATH=./routing/graphhopper/data/artifacts/versions
GRAPHHOPPER_GRAPH_ARTIFACT_PATH=./routing/graphhopper/data/artifacts/versions/graphhopper-10.2
ROUTING_MANIFEST_PATH=./routing/manifest/versions/REPLACE_WITH_MANIFEST_ID/meeet-routing-manifest.json
ROUTING_MANIFEST_SHA256=REPLACE_WITH_GENERATED_MANIFEST_SHA256
OTP_RUNTIME_LOCK_PATH=./routing/manifest/versions/REPLACE_WITH_MANIFEST_ID/otp-runtime.files.sha256
GRAPHHOPPER_RUNTIME_LOCK_PATH=./routing/manifest/versions/REPLACE_WITH_MANIFEST_ID/graphhopper-runtime.files.sha256
ROUTING_VERIFY_LOCK_PATH=./routing/manifest/versions/REPLACE_WITH_MANIFEST_ID/verify-all.files.sha256
