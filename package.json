{
  "name": "meeet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify-trace": "node scripts/build-and-verify-traces.mjs",
    "certify:route-first:inactive": "node scripts/certify-route-first-inactive.mjs",
    "deploy:preflight": "node deploy/preflight-production.mjs",
    "icons:brand": "tsx scripts/generate-brand-icons.ts",
    "icons:check": "tsx scripts/check-brand-icons.ts",
    "start": "next start",
    "schedule:compile:mvv": "NODE_OPTIONS=--conditions=react-server tsx scripts/compile-mvv-schedule.ts",
    "schedule:compile:fixture": "NODE_OPTIONS=--conditions=react-server tsx scripts/compile-fixture-schedule.ts",
    "profile:calculation": "NODE_OPTIONS=--conditions=react-server tsx scripts/profile-scheduled-calculation.ts",
    "profile:calculation:cpu": "NODE_OPTIONS=--conditions=react-server tsx scripts/profile-scheduled-calculation.ts --inspector-cpu",
    "lint": "eslint",
    "test": "tsx --test --import ./test/server-only-register.mjs test/*.test.ts",
    "test:e2e": "playwright test",
    "boundary:refresh": "tsx scripts/refresh-munich-boundary.ts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "maplibre-gl": "6.0.0",
    "next": "16.2.12",
    "polygon-clipping": "0.15.7",
    "proj4": "^2.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^24",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
